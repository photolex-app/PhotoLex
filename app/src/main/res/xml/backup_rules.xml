<?xml version="1.0" encoding="utf-8"?><!--
   Legacy Auto Backup config, used on API <= 31. Explicitly including the OCR index databases
   here is a free, best effort safety net alongside the app's own manual Backup/Restore Index
   feature (Settings, Data and Backup). Auto Backup only runs opportunistically (wifi, idle,
   signed into a Google account), isn't guaranteed to run before an uninstall, and is capped at
   25MB, so it's a complement to the manual backup, not a replacement for it.
-->
<full-backup-content>
    <include domain="database" path="media-database" />
    <include domain="database" path="media-database-wal" />
    <include domain="database" path="media-database-shm" />
    <include domain="database" path="photo-classification-database" />
    <include domain="database" path="photo-classification-database-wal" />
    <include domain="database" path="photo-classification-database-shm" />
</full-backup-content>
