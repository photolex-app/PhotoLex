<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Gallery.Splashscreen" parent="Theme.SplashScreen.IconBackground">
        <item name="postSplashScreenTheme">@style/Theme.Gallery</item>

        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#101B33</item>
        <item name="android:windowSplashScreenBackground">#101B33</item>
    </style>

    <style name="Theme.Gallery" parent="Theme.Material3.DayNight">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Without this, Theme.Material3.DayNight's own default (a pale lavender) shows for
             one frame during the native-splash-to-Compose handoff. -->
        <item name="android:windowBackground">@color/splash_post_background</item>
        <item name="android:colorBackground">@color/splash_post_background</item>
    </style>
</resources>