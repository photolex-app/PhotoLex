<?xml version="1.0" encoding="utf-8"?>
<!--
  PhotoLex app icon (photolex_icon_v5.png), used only as the adaptive-icon foreground layer
  (in-app UI uses drawable/ic_launcher_photolex directly instead, see MainBars.kt comment).
  Adaptive icons mask this 108dp x 108dp layer down to a smaller "safe zone" that varies by
  launcher/OEM shape, and corners get clipped harder than the flat edges. A uniform 10% inset,
  an earlier attempt at making the artwork bigger per user feedback, pushed the magnifying
  glass handle (which extends toward the bottom-right corner of the source image) past where
  the launcher's mask crops, cutting the handle off entirely on the home-screen icon (confirmed:
  it still rendered fine in-app, where this image is shown flat with no masking). Asymmetric
  insets fix this without giving back all the size gained: less padding on the top and left
  (8%, where content doesn't reach the edge anyway) and more on the bottom and right (15%,
  protecting the handle specifically).
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_photolex"
    android:insetLeft="8%"
    android:insetTop="8%"
    android:insetRight="15%"
    android:insetBottom="15%" />
