<?xml version="1.0" encoding="utf-8"?>
<!--
  PhotoLex app icon (photolex_icon_v5.png), used only as the adaptive-icon foreground layer
  (in-app UI uses drawable/ic_launcher_photolex directly instead, see MainBars.kt comment).

  Android's adaptive-icon spec masks this 108dp x 108dp layer down to whatever shape the
  launcher/OEM uses (circle, squircle, rounded square, teardrop...), but only guarantees that
  the inner 66dp safe zone survives every shape;that's an 18dp margin on all four sides,
  i.e. ~16.7% inset minimum. A previous asymmetric-inset attempt (8% top/left, 15% bottom/right)
  undershot that on every side;it was tuned only against the bottom-right magnifying-glass
  handle getting clipped, not against the actual safe-zone requirement, so the top-left "photo
  card" corner and header bar were still landing outside the guaranteed-safe area and got cut
  by the circular mask on this Pixel 8 profile. Bumped to clear the safe zone on all sides, with
  extra margin on the bottom/right to keep protecting the handle specifically (confirmed the
  full, uncropped artwork still renders fine in-app, where this image is shown flat with no
  masking;see MainBars.kt).
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_photolex"
    android:insetLeft="18%"
    android:insetTop="18%"
    android:insetRight="22%"
    android:insetBottom="22%" />
